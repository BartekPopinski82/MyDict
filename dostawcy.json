      "endpoint_note": "EU: https://api.eu.deepgram.com/v1 · USA: https://api.deepgram.com/v1",
      "params": {
        "smart_format": "true",
        "punctuate": "true"
      },
      "streaming_params": {
        "interim_results": "true",
        "endpointing": "200",
        "local_finalize_ms": "400"
      },
      "stream": true
    },
    "assemblyai": {
      "name": "AssemblyAI",
